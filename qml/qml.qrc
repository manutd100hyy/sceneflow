<RCC>
    <qresource prefix="/">
        <file alias="qtquickcontrols2.conf">qtquickcontrols2.conf</file>
        <file>SrStyle/qmldir</file>
        <file>SrStyle/Button.qml</file>
        <file>SrStyle/ToolButton.qml</file>
        <file>SrStyle/TabButton.qml</file>
        <file>SrStyle/TabBar.qml</file>
        <file>SrStyle/TextField.qml</file>
        <file>SrStyle/ItemDelegate.qml</file>
        <file>SrStyle/ComboBox.qml</file>
    </qresource>
    <qresource prefix="/qml">
        <file>Main.qml</file>
        <file>HomePage.qml</file>
        <file>CaseList.qml</file>
        <file>Workspace.qml</file>
        <file>CaseInfoPane.qml</file>
        <file>EditorPane.qml</file>
        <file>PhotosPane.qml</file>
        <file>FormsPane.qml</file>
        <file>LibraryColumn.qml</file>
        <file>PropertyColumn.qml</file>
        <file>ToolGlyph.qml</file>
    </qresource>
</RCC>
